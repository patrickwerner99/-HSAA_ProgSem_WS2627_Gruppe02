########################################################################################
# Bestellen als Kunde – B1, B2, B3, 0009, 0010
########################################################################################

### Bestellen (mitgeschickter Preis wird ignoriert) – erwartet 201 + Location
POST {{host}}/api/orders
Content-Type: application/json

{ "items": [ { "productId": {{productId}}, "quantity": 2, "price": 0.01 } ] }

> {%
    client.test("201, Location, Preis vom Server", () => {
        client.assert(response.status === 201, "Status " + response.status);
        client.assert(response.headers.valueOf("Location") !== null, "Location fehlt");
        client.assert(response.body.lines[0].unitPrice > 0.01, "Preis vom Browser übernommen!");
        client.assert(response.body.status === "RECEIVED", response.body.status);
    });
    client.global.set("orderId", response.body.id);
%}

### FEHLER: mehr bestellen als auf Lager – erwartet 409 mit items
POST {{host}}/api/orders
Content-Type: application/json

{ "items": [ { "productId": {{productId}}, "quantity": 99 } ] }

> {%
    client.test("409 + items", () => {
        client.assert(response.status === 409, "Status " + response.status);
        client.assert(response.body.items.length === 1, JSON.stringify(response.body));
    });
%}

### FEHLER: leerer Warenkorb – erwartet 400
POST {{host}}/api/orders
Content-Type: application/json

{ "items": [] }

> {%
    client.test("400", () => client.assert(response.status === 400, "Status " + response.status));
%}

