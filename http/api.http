# ---- Produkte ----

### Produkt anlegen – erwartet 201 + Location
POST {{host}}/api/products
Content-Type: application/json

{ "name": "Test-Produkt", "description": "Aus der .http-Datei", "price": 19.9, "stock": 3,
  "imageUrl": null, "categoryId": {{categoryId}} }

> {%
    client.test("201 + Location", () => {
        client.assert(response.status === 201, "Status " + response.status);
        client.assert(response.headers.valueOf("Location") !== null, "Location fehlt");
    });
    client.global.set("newProductId", response.body.id);
%}

### FEHLER: ungültiges Produkt – erwartet 400 mit Feldfehlern
POST {{host}}/api/products
Content-Type: application/json

{ "name": "", "price": -5, "stock": 3.5, "categoryId": {{categoryId}} }

> {%
    client.test("400 + Feldfehler", () => {
        client.assert(response.status === 400, "Status " + response.status);
        client.assert(response.body.errors.length >= 3, JSON.stringify(response.body.errors));
    });
%}

### Produkt ganz ändern (PUT) – erwartet 200
PUT {{host}}/api/products/{{newProductId}}
Content-Type: application/json

{ "name": "Test-Produkt geändert", "description": null, "price": 21.5, "stock": 7,
  "imageUrl": null, "categoryId": {{categoryId}} }

> {%
    client.test("200", () => client.assert(response.status === 200, "Status " + response.status));
%}

### Nur den Bestand ändern (PATCH) – erwartet 200
PATCH {{host}}/api/products/{{newProductId}}
Content-Type: application/json

{ "stock": 12 }

> {%
    client.test("200 + Bestand 12", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.stock === 12, response.body.stock);
    });
%}

### FEHLER: negativer Bestand – erwartet 400
PATCH {{host}}/api/products/{{newProductId}}
Content-Type: application/json

{ "stock": -1 }

> {%
    client.test("400", () => client.assert(response.status === 400, "Status " + response.status));
%}

# ---- Bilder ----

### Bild hochladen – erwartet 200, imageUrl ist eine URL der API (D2)
POST {{host}}/api/products/{{newProductId}}/image
Content-Type: multipart/form-data; boundary=Grenze

--Grenze
Content-Disposition: form-data; name="file"; filename="test-bild.png"
Content-Type: image/png

< ./test-bild.png
--Grenze--

> {%
    client.test("200 + /api/images/…", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.imageUrl.startsWith("/api/images/"), response.body.imageUrl);
    });
    client.global.set("imageUrl", response.body.imageUrl);
%}

### Bild abrufen – erwartet 200 image/png
GET {{host}}{{imageUrl}}

> {%
    client.test("200 + PNG", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.contentType.mimeType === "image/png", response.contentType.mimeType);
    });
%}

### FEHLER: Textdatei statt Bild – erwartet 400
POST {{host}}/api/products/{{newProductId}}/image
Content-Type: multipart/form-data; boundary=Grenze

--Grenze
Content-Disposition: form-data; name="file"; filename="notiz.txt"
Content-Type: text/plain

Das ist kein Bild.
--Grenze--

> {%
    client.test("400", () => client.assert(response.status === 400, "Status " + response.status));
%}

### FEHLER: Bild gibt es nicht – erwartet 404
GET {{host}}/api/images/00000000-0000-0000-0000-000000000000.png

> {%
    client.test("404", () => client.assert(response.status === 404, "Status " + response.status));
%}

### Bild entfernen – erwartet 200, Produkt ohne Bild (Frontend zeigt Platzhalter, D3)
DELETE {{host}}/api/products/{{newProductId}}/image

> {%
    client.test("200 + kein Bild", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.imageUrl === null || response.body.imageUrl === undefined, response.body.imageUrl);
    });
%}

