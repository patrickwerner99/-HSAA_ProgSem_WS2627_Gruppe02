### Bestellen mit gespeicherter Adresse und Rabattcode – erwartet 201, Adresse kopiert, 10 % Rabatt
POST {{host}}/api/orders
Content-Type: application/json

{ "items": [ { "productId": {{productId}}, "quantity": 1 } ], "addressId": {{workAddressId}}, "discountCode": "HYROX10" }

> {%
    client.test("201 + Adresse + Rabatt", () => {
        client.assert(response.status === 201, "Status " + response.status);
        client.assert(response.body.deliveryAddress.street === "Anton-Huber-Straße 25", JSON.stringify(response.body.deliveryAddress));
        client.assert(response.body.discountPercent === 10, JSON.stringify(response.body));
        client.assert(response.body.total < response.body.subtotal, "kein Rabatt abgezogen");
    });
    client.global.set("discountOrderId", response.body.id);
%}

