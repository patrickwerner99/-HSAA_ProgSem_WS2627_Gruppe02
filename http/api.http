{ "items": [ { "productId": {{productId}}, "quantity": 1 } ],
  "deliveryAddress": { "name": "Max Muster", "street": "Beethovenstraße 1", "postalCode": "123", "city": "Aalen" } }

> {%
    client.test("400 + Feld PLZ", () => {
        client.assert(response.status === 400, "Status " + response.status);
        client.assert(response.body.errors.some(e => e.field === "deliveryAddress.postalCode"), JSON.stringify(response.body));
    });
%}

