########################################################################################
# Sale und Nährwerte (für alle) – Sprint 3, G1, H1/H2, 0023, 0027
########################################################################################

### Sale-Bereich, größte Ersparnis zuerst – erwartet 200, alle onSale mit Ersparnis
GET {{host}}/api/products?sale=true&sort=saving

> {%
    client.test("200 + nur Sale", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.items.length > 0, "keine Sale-Produkte");
        client.assert(response.body.items.every(p => p.onSale && p.price < p.regularPrice && p.savingPercent > 0),
            JSON.stringify(response.body.items));
    });
%}

### Produkt mit Barcode suchen (für die Nährwerte) – erwartet 200
GET {{host}}/api/products?q=Whey%20Protein%20Schoko

> {%
    client.test("200 + Produkt mit EAN", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.items.some(p => p.ean), "kein Produkt mit EAN");
    });
    client.global.set("eanProductId", response.body.items.find(p => p.ean).id);
%}

### Nährwerte aus Open Food Facts – erwartet 200 (oder 503, wenn Open Food Facts gerade nicht erreichbar ist, H2)
GET {{host}}/api/products/{{eanProductId}}/nutrition

> {%
    client.test("200 mit Nährwerten oder 503 als Problem Details", () => {
        client.assert(response.status === 200 || response.status === 503, "Status " + response.status);
        if (response.status === 200) {
            client.assert(response.body.source === "Open Food Facts", response.body.source);
            client.assert(typeof response.body.protein === "number", JSON.stringify(response.body));
        } else {
            client.assert(response.contentType.mimeType === "application/problem+json", response.contentType.mimeType);
        }
    });
%}

