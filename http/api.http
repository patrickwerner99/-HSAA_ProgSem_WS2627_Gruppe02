########################################################################################
# Konto – A1, 0006
########################################################################################

### Registrieren mit zufälliger E-Mail – erwartet 201, danach angemeldet
< {%
    request.variables.set("customerEmail", "kunde-" + Math.random().toString(36).substring(2, 10) + "@example.de");
%}
POST {{host}}/api/auth/register
Content-Type: application/json

{ "name": "Test Kunde", "email": "{{customerEmail}}", "password": "geheim1234" }

> {%
    client.test("201, Rolle CUSTOMER, kein Passwort in der Antwort", () => {
        client.assert(response.status === 201, "Status " + response.status);
        client.assert(response.body.role === "CUSTOMER", response.body.role);
        client.assert(response.body.password === undefined && response.body.passwordHash === undefined, "Passwort in Antwort!");
    });
    client.global.set("customerEmail", response.body.email);
%}

### FEHLER: gleiche E-Mail nochmal – erwartet 409
POST {{host}}/api/auth/register
Content-Type: application/json

{ "name": "Test Kunde", "email": "{{customerEmail}}", "password": "geheim1234" }

> {%
    client.test("409", () => client.assert(response.status === 409, "Status " + response.status));
%}

### FEHLER: ungültige Registrierung – erwartet 400 mit Feldfehlern
POST {{host}}/api/auth/register
Content-Type: application/json

{ "name": "", "email": "keine-mail", "password": "kurz" }

> {%
    client.test("400 + 3 Feldfehler", () => {
        client.assert(response.status === 400, "Status " + response.status);
        client.assert(response.body.errors.length >= 3, JSON.stringify(response.body.errors));
    });
%}

### FEHLER: Anmelden mit falschem Passwort – erwartet 401
POST {{host}}/api/auth/login
