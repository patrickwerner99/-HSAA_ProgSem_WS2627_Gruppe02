# ---- Sale (G1, 0023) ----

### Test-Produkt in den Sale – erwartet 200, price ist jetzt der Sale-Preis
< {%
    const today = new Date().toISOString().substring(0, 10);
    const later = new Date(Date.now() + 14 * 86400000).toISOString().substring(0, 10);
    request.variables.set("today", today);
    request.variables.set("later", later);
    client.global.set("today", today);
%}
PUT {{host}}/api/products/{{newProductId}}/sale
Content-Type: application/json

{ "salePrice": 14.9, "from": "{{today}}", "until": "{{later}}" }

> {%
    client.test("200 + Sale", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.onSale === true && response.body.price === 14.9, JSON.stringify(response.body));
        client.assert(response.body.regularPrice > response.body.price, JSON.stringify(response.body));
    });
%}

### FEHLER: Sale-Preis höher als der normale Preis – erwartet 400 mit Feldfehler "salePrice"
PUT {{host}}/api/products/{{newProductId}}/sale
Content-Type: application/json

{ "salePrice": 29.9, "from": "{{today}}", "until": "2099-12-31" }

> {%
    client.test("400 + Feld salePrice", () => {
        client.assert(response.status === 400, "Status " + response.status);
        client.assert(response.body.errors[0].field === "salePrice", JSON.stringify(response.body));
    });
%}

### FEHLER: Sale endet in der Vergangenheit – erwartet 400 mit Feldfehler "until"
PUT {{host}}/api/products/{{newProductId}}/sale
Content-Type: application/json

{ "salePrice": 14.9, "from": "2020-01-01", "until": "2020-01-31" }

> {%
    client.test("400", () => client.assert(response.status === 400, "Status " + response.status));
%}

### Sale beenden – erwartet 200, wieder normaler Preis
DELETE {{host}}/api/products/{{newProductId}}/sale

> {%
    client.test("200 + normaler Preis", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.onSale === false && response.body.price === response.body.regularPrice, JSON.stringify(response.body));
    });
%}

