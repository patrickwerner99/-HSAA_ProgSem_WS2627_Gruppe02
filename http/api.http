# Hyrox-Shop REST-API – jeder Endpunkt mit Erfolgs- und Fehlerfall (N2, docs/anforderungen/0015)
#
# So geht's (IntelliJ IDEA / WebStorm, eingebauter HTTP Client):
#   1. Shop starten: docker compose up -d --build
#   2. http-client.private.env.example.json kopieren nach http-client.private.env.json
#      und das Admin-Passwort eintragen (README → "Admin-Zugang"). Die Datei ist in .gitignore (Q3).
#   3. Oben Umgebung "dev" wählen, dann "Run All Requests in File".
#      Jeder Aufruf prüft seinen erwarteten Statuscode selbst (grün/rot im Ergebnisfenster).
#
# Die Aufrufe bauen aufeinander auf (Cookie der Sitzung, gemerkte IDs). Am besten immer die ganze
# Datei von oben ausführen. Mehrfaches Ausführen ist okay: neue Kunden bekommen eine zufällige E-Mail.

########################################################################################
# Allgemein
########################################################################################

### Healthcheck – erwartet 200
GET {{host}}/api/health

> {%
    client.test("200 OK", () => client.assert(response.status === 200, "Status " + response.status));
%}

### Unbekannte Adresse – erwartet 404 als Problem Details
GET {{host}}/api/products/1/gibtsnicht

> {%
    client.test("404 + Problem Details", () => {
        client.assert(response.status === 404, "Status " + response.status);
        client.assert(response.contentType.mimeType === "application/problem+json", response.contentType.mimeType);
    });
%}

########################################################################################
# Produkte lesen (für alle) – 0001, 0002, 0012
########################################################################################

### Produkte, erste Seite (12 Stück) – erwartet 200
GET {{host}}/api/products?page=0&size=12

> {%
    client.test("200 + Seite", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.items.length <= 12, "zu viele Produkte");
        client.assert(typeof response.body.last === "boolean", "Feld last fehlt");
    });
%}

### Suche + Kategorie kombiniert, sortiert nach Preis absteigend, nur verfügbare – erwartet 200
GET {{host}}/api/products?q=kreatin&sort=price-desc&inStock=true

> {%
    client.test("200, kein ausverkauftes Produkt", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.items.every(p => p.stockStatus !== "SOLD_OUT"), "ausverkauftes Produkt in Liste");
    });
    // IDs für spätere Aufrufe merken
    const neutral = response.body.items.find(p => p.name === "Kreatin Neutral");
    if (neutral) client.global.set("productId", neutral.id);
%}

### Neuheiten zuerst – erwartet 200
GET {{host}}/api/products?sort=newest

> {%
    client.test("200 OK", () => client.assert(response.status === 200, "Status " + response.status));
%}

### FEHLER: unbekannte Sortierung – erwartet 400 mit Feldfehler "sort"
GET {{host}}/api/products?sort=billig

> {%
    client.test("400 + Feld sort", () => {
        client.assert(response.status === 400, "Status " + response.status);
        client.assert(response.body.errors[0].field === "sort", JSON.stringify(response.body));
    });
%}

### Ein Produkt – erwartet 200 mit stockStatus und imageUrl
GET {{host}}/api/products/{{productId}}

> {%
    client.test("200 + stockStatus", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(["IN_STOCK", "LOW_STOCK", "SOLD_OUT"].includes(response.body.stockStatus), "stockStatus fehlt");
    });
%}

